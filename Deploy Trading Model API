from flask import Flask, request, jsonify
import joblib
import numpy as np
from tensorflow.keras.models import load_model

app = Flask(__name__)

# Load trained LSTM model and scaler
model = load_model("lstm_model.keras")
scaler = joblib.load("scaler.pkl")

@app.route("/")
def home():
    return "LSTM Trading Model API is Running!"

@app.route("/predict", methods=["POST"])
def predict():
    try:
        data = request.json["price"]
        data_scaled = scaler.transform(np.array(data).reshape(-1, 1))
        prediction = model.predict(np.array([data_scaled]))
        result = scaler.inverse_transform(prediction)
        return jsonify({"predicted_price": result.tolist()})
    except Exception as e:
        return jsonify({"error": str(e)})

if __name__ == "__main__":
    app.run(debug=True, port=6000)
